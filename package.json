{
  "name": "corgtex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/site",
    "apps/web",
    "apps/worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:client": "concurrently -k -n web,worker \"DOTENV_CONFIG_PATH=.env.client npm run dev:web\" \"DOTENV_CONFIG_PATH=.env.client npm run dev:worker\"",
    "dev:web": "npm --workspace @corgtex/web run dev",
    "dev:worker": "npm --workspace @corgtex/worker run dev",
    "dev:site": "npm --workspace @corgtex/site run dev",
    "build": "npm run prisma:generate && npm --workspace @corgtex/web run build",
    "build:site": "npm --workspace @corgtex/site run build",
    "start": "npm --workspace @corgtex/web run start",
    "start:site": "npm --workspace @corgtex/site run start",
    "lint": "eslint apps packages",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run test:db:up && vitest run --project integration; status=$?; npm run test:db:down; exit $status",
    "test:all": "npm run test:db:up && vitest run --project unit --project integration; status=$?; npm run test:db:down; exit $status",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:smoke:site": "node scripts/site-smoke.mjs",
    "smoke:railway": "node scripts/check-migration-health.mjs && node scripts/railway-smoke.mjs",
    "smoke:ingestion-guidance": "node scripts/ingestion-guidance-smoke.mjs",
    "smoke:source-intake": "node scripts/source-intake-production-smoke.mjs",
    "smoke:work-item-parity": "node scripts/work-item-parity-production-smoke.mjs",
    "smoke:briefing-fixture": "tsx scripts/briefing-fixture-production-smoke.mjs",
    "smoke:recorder-readiness": "tsx scripts/recorder-readiness-production-smoke.mjs",
    "meeting-recorder:enable": "node scripts/meeting-recorder-enable.mjs",
    "meeting-recorder:backfill-paid-access": "node scripts/backfill-paid-recorder-access.mjs",
    "member:cleanup": "tsx scripts/member-cleanup-runner.ts",
    "smoke:meeting-recorder": "node scripts/meeting-recorder-smoke.mjs",
    "test:e2e:agents": "npx dotenv-cli -- node scripts/e2e-agent-tests.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:seed": "npm run seed:base",
    "seed:base": "node prisma/seed.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "seed:pilot-tester": "node scripts/seed-pilot-tester.mjs",
    "seed:dogfood": "node scripts/seed-corgtex.mjs",
    "seed:dogfood-demo": "npm run seed:dogfood && npm run seed:jnj-demo",
    "seed:demo-video": "npm run seed:jnj-demo && npx tsx scripts/seed-demo-video.ts",
    "seed:brain": "node scripts/seed-brain.mjs",
    "seed:client-stable": "node scripts/seed-client-stable.mjs",
    "seed:validation": "node scripts/seed-internal-validation-workspace.mjs",
    "seed:jnj-demo": "node scripts/seed-jnj-demo.mjs",
    "cleanup:test-artifacts": "node scripts/cleanup-test-artifacts.mjs",
    "contrast-audit": "node scripts/contrast-audit.mjs",
    "smoke:client": "node scripts/client-readiness-smoke.mjs",
    "smoke:self-serve-browser": "node scripts/self-serve-browser-smoke.mjs",
    "smoke:self-serve-readiness": "node scripts/self-serve-production-readiness.mjs",
    "smoke:azure-domain-readiness": "node scripts/azure-selfserve-domain-readiness.mjs",
    "smoke:self-serve-hidden-prod": "node scripts/self-serve-hidden-production-smoke.mjs",
    "smoke:stripe-billing": "node scripts/stripe-billing-smoke.mjs",
    "smoke:proposal-discussion": "node scripts/proposal-discussion-smoke.mjs",
    "ops:health-sweep": "node scripts/ops/health-sweep.mjs",
    "ops:github-incident": "node scripts/ops/github-incident.mjs",
    "ops:railway-action": "node scripts/ops/railway-action.mjs",
    "ops:smoke": "node scripts/ops/smoke-orchestrator.mjs",
    "ops:load-smoke": "node scripts/nightly-load-smoke.mjs",
    "ops:nightly-research": "node scripts/nightly-research-report.mjs",
    "release:fleet": "node scripts/release-fleet.mjs",
    "release:db": "node scripts/release-db.mjs",
    "control-plane": "node scripts/control-plane.mjs",
    "slack:sync-public-archive": "node scripts/sync-slack-public-archive.mjs",
    "posthog:check": "node scripts/posthog-setup-check.mjs",
    "check:unused": "node scripts/repo-cleanliness-report.mjs",
    "check:unused:knip": "knip --no-progress --no-exit-code --reporter compact",
    "check:unused:locals": "node scripts/repo-cleanliness-report.mjs --locals-only",
    "report:ui-spine": "node scripts/ui-spine-drift-report.mjs",
    "check:public-docs": "node scripts/check-public-docs.mjs",
    "check:private-boundary": "node scripts/check-private-boundary.mjs",
    "check:migration-fixtures": "node scripts/check-data-migration-fixtures.mjs",
    "check:seed-fixtures": "node scripts/check-seed-fixtures.mjs",
    "meeting-recorder:cleanup": "node scripts/meeting-recorder-cleanup.mjs",
    "knowledge:azure-search": "tsx scripts/azure-knowledge-search.ts",
    "check": "npm run lint && npm run typecheck && npm run prisma:validate && npm run check:public-docs && npm run check:private-boundary && npm run contrast-audit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "10.53.1",
    "@sentry/node": "10.53.1",
    "@slack/web-api": "^7.16.0",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.10.2",
    "bcrypt": "^6.0.0",
    "dagre": "^0.8.5",
    "driver.js": "^1.4.0",
    "jszip": "^3.10.1",
    "next": "15.5.18",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.15",
    "knip": "^6.26.0",
    "postcss": "8.5.12",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.12"
    },
    "postcss": "8.5.12"
  }
}
