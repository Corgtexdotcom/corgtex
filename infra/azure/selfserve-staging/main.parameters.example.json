{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "westus3"
    },
    "namePrefix": {
      "value": "corgtex-ss-stg"
    },
    "deployContainerApps": {
      "value": false
    },
    "appUrl": {
      "value": "https://selfserve-staging.corgtex.com"
    },
    "siteUrl": {
      "value": "https://www.corgtex.com"
    },
    "controlPlaneUrl": {
      "value": "https://ops.corgtex.com"
    },
    "webImage": {
      "value": "ghcr.io/corgtexdotcom/corgtex/web:sha-replace-with-git-sha"
    },
    "workerImage": {
      "value": "ghcr.io/corgtexdotcom/corgtex/worker:sha-replace-with-git-sha"
    },
    "registryUsername": {
      "value": "corgtex-deploy"
    },
    "azureOpenAiBaseUrl": {
      "value": "https://replace-me.openai.azure.com/openai/v1"
    },
    "azureFoundryBaseUrl": {
      "value": ""
    },
    "modelProvider": {
      "value": "azure-openai"
    },
    "azureOpenAiAuthMode": {
      "value": "managed_identity"
    },
    "allowAzureServicePostgresFirewall": {
      "value": false
    },
    "postgresAllowedExtensions": {
      "value": "vector"
    },
    "bootstrapAdminEmail": {
      "value": "admin+selfserve-staging@corgtex.com"
    },
    "enableStripeSecrets": {
      "value": false
    },
    "enableResendSecrets": {
      "value": false
    },
    "enableGoogleOauthSecrets": {
      "value": false
    },
    "enableMicrosoftOauthSecrets": {
      "value": false
    }
  }
}
