  topic        String?
  status       ConversationStatus @default(ACTIVE)
  systemPrompt String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns          ConversationTurn[]
  roleOnboarding RoleOnboardingSession?
  checkIns       CheckIn[]

  @@index([workspaceId, userId, status])
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum ConversationPendingOperationStatus {
  PENDING
  EXECUTING
  EXECUTED
  CANCELED
  EXPIRED
  FAILED
}

model ConversationPendingOperation {
  id                String                             @id @default(uuid())
  workspaceId       String
  conversationId    String
  userId            String?
  agentKey          String
  toolName          String
  argsJson          Json
  argsHash          String
  idempotencyKey    String
  relatedEntityType String?
  relatedEntityId   String?
  riskLabel         String
  status            ConversationPendingOperationStatus @default(PENDING)
  resultJson        Json?
  errorCode         String?
  errorMessage      String?                            @db.Text
  proposedAt        DateTime                           @default(now())
  expiresAt         DateTime
  executedAt        DateTime?
  canceledAt        DateTime?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([conversationId, status, createdAt])
  @@index([workspaceId, status, expiresAt])
  @@index([userId])
}

enum RoleHolderKind {
  MEMBER
  AGENT
}

enum RoleOnboardingStatus {
  PENDING
  ACTIVE
  COMPLETED
  DISMISSED
}

model ConversationTurn {
  id               String   @id @default(uuid())
  conversationId   String
  sequenceNumber   Int
  userMessage      String   @db.Text
  assistantMessage String   @db.Text
  contextJson      Json?
  agentRunId       String?
  createdAt        DateTime @default(now())

  conversation ConversationSession @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?           @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([conversationId, sequenceNumber])
}

model AgentMemory {
  id          String   @id @default(uuid())
  workspaceId String
  agentKey    String
  memoryType  String
  content     String   @db.Text
  embedding   Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, agentKey, memoryType])
}

// --- Brain (Company Knowledge Wiki) ---

model BrainArticle {
  id               String                @id @default(uuid())
  workspaceId      String
  slug             String
  title            String
  type             BrainArticleType
  authority        BrainArticleAuthority @default(DRAFT)
  bodyMd           String                @db.Text
  frontmatterJson  Json?
  ownerMemberId    String?
  isPrivate        Boolean               @default(false)
  publishedAt      DateTime?
  lastVerifiedAt   DateTime?
  staleAfterDays   Int                   @default(90)
  sourceIds        String[]
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerMember   Member?                 @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  versions      BrainArticleVersion[]
  backlinksFrom BrainBacklink[]         @relation("BacklinkFrom")
  backlinksTo   BrainBacklink[]         @relation("BacklinkTo")
  discussions   BrainDiscussionThread[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, type])
  @@index([workspaceId, authority])
  @@index([workspaceId, archivedAt])
}

model BrainArticleVersion {
  id            String   @id @default(uuid())
  articleId     String
  version       Int
  bodyMd        String   @db.Text
  changeSummary String?
  agentRunId    String?
  createdAt     DateTime @default(now())

  article BrainArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, version])
}

model BrainSource {
  id                  String                @id @default(uuid())
  workspaceId         String
  accessDomain        KnowledgeAccessDomain @default(WORKSPACE)
  sourceType          BrainSourceType
  tier                Int
  externalId          String?
  authorMemberId      String?
  channel             String?
  title               String?
  content             String          @db.Text
  ingestionGuidanceMd String?         @db.Text
  metadata            Json?
  fileStorageKey      String?
  fileName            String?
  fileMimeType        String?
  fileSizeBytes       Int?
  absorbedAt          DateTime?
  archivedAt          DateTime?
  archivedByUserId    String?
  archiveReason       String?
  createdAt           DateTime        @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorMember  Member?        @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)
  buildArtifact BuildArtifact?
  financeImportBatches FinanceImportBatch[]

  @@unique([id, workspaceId])
  @@index([workspaceId, sourceType])
  @@index([workspaceId, absorbedAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, accessDomain, archivedAt])
  @@index([workspaceId, accessDomain, absorbedAt])
}

model BrainBacklink {
  id            String   @id @default(uuid())
  workspaceId   String
  fromArticleId String
  toArticleId   String
  createdAt     DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromArticle BrainArticle @relation("BacklinkFrom", fields: [fromArticleId], references: [id], onDelete: Cascade)
  toArticle   BrainArticle @relation("BacklinkTo", fields: [toArticleId], references: [id], onDelete: Cascade)

  @@unique([fromArticleId, toArticleId])
  @@index([workspaceId])
}

model BrainDiscussionThread {
  id             String                    @id @default(uuid())
  articleId      String
  authorMemberId String
  targetType     BrainDiscussionTargetType
  targetRef      String?
  status         BrainDiscussionStatus     @default(OPEN)
  createdAt      DateTime                  @default(now())
  resolvedAt     DateTime?
  absorbedAt     DateTime?

  article      BrainArticle             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorMember Member                   @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)
  comments     BrainDiscussionComment[]

  @@index([articleId, status])
}

model BrainDiscussionComment {
  id             String   @id @default(uuid())
  threadId       String
  authorMemberId String?
  agentRunId     String?
  bodyMd         String   @db.Text
  createdAt      DateTime @default(now())

  thread       BrainDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorMember Member?               @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([threadId])
}

// --- Integrations ---

enum WebhookEndpointStatus {
  ACTIVE
  PAUSED
  DISABLED
}

model WebhookEndpoint {
  id               String                @id @default(uuid())
  workspaceId      String
  url              String
  secret           String
  label            String?
  eventTypes       String[]              @default([])
  status           WebhookEndpointStatus @default(ACTIVE)
  metadata         Json?
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, status])
  @@index([workspaceId, archivedAt])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id              String                @id @default(uuid())
  endpointId      String
  eventId         String?
  eventType       String
  payload         Json
  status          WebhookDeliveryStatus @default(PENDING)
  httpStatus      Int?
  responseBody    String?               @db.Text
  attempts        Int                   @default(0)
  lastAttemptedAt DateTime?
  nextRetryAt     DateTime?
  error           String?               @db.Text
  createdAt       DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@index([status, nextRetryAt])
}

model InboundWebhook {
  id          String    @id @default(uuid())
  workspaceId String
  source      String
  externalId  String?
  payload     Json
  processedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, source])
  @@index([source, externalId])
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

model OAuthConnection {
  id                  String                @id @default(uuid())
  userId              String
  workspaceId         String?
  provider            OAuthProvider
  providerAccountId   String
  accessToken         String                @db.Text
  refreshToken        String?               @db.Text
  tokenStorageVersion String                @default("plaintext")
  expiresAt           DateTime?
  scopes              String[]              @default([])
  providerEmail       String?
  status              OAuthConnectionStatus @default(ACTIVE)
  syncSettings        Json?
  lastSyncAt          DateTime?
  lastSyncError       String?
  disconnectedAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([workspaceId, provider, status])
}

// --- Expertise Tracking ---

model ExpertiseTag {
  id               String    @id @default(uuid())
  workspaceId      String
  label            String
  slug             String
  description      String?
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime  @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   MemberExpertise[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

enum ExpertiseLevel {
  LEARNING
  PRACTITIONER
  EXPERT
  AUTHORITY
}

model MemberExpertise {
  id             String         @id @default(uuid())
  memberId       String
  expertiseTagId String
  level          ExpertiseLevel @default(PRACTITIONER)
  endorsedCount  Int            @default(0)
  source         String         @default("SELF") // "SELF" | "AI_INFERRED" | "PEER_ENDORSED"
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expertiseTag ExpertiseTag @relation(fields: [expertiseTagId], references: [id], onDelete: Cascade)

  @@unique([memberId, expertiseTagId])
  @@index([expertiseTagId])
}

// --- Advice Process ---

enum AdviceProcessStatus {
  GATHERING
  READY
  EXECUTED
  WITHDRAWN
}

enum AdviceRequestAudienceType {
  MEMBERS
  CIRCLE
  WORKSPACE
}

enum AdviceRequestPreferredChannel {
  IN_APP
  SLACK
  EMAIL
  COPY
}

enum AdviceRequestStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

model AdviceProcess {
  id             String              @id @default(uuid())
  workspaceId    String
  proposalId     String?             @unique
  authorMemberId String
  ownerMemberId  String?
  subjectType    String              @default("PROPOSAL")
  subjectId      String
  status         AdviceProcessStatus @default(GATHERING)
  adviceDeadline DateTime?
  closedAt       DateTime?
  executedAt     DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposal     Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorMember Member          @relation("AdviceProcessAuthor", fields: [authorMemberId], references: [id], onDelete: Restrict)
  ownerMember  Member?         @relation("AdviceProcessOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  requests     AdviceRequest[]

  @@index([workspaceId, status])
  @@index([workspaceId, subjectType, subjectId])
  @@index([workspaceId, subjectType, status])
  @@index([ownerMemberId])
}

model AdviceRequest {
  id                String                        @id @default(uuid())
  workspaceId       String
  processId         String
  requestedByUserId String
  audienceType      AdviceRequestAudienceType
  targetCircleId    String?
  messageMd         String                        @db.Text
  deadlineAt        DateTime?
  reminderAt        DateTime?
  preferredChannel  AdviceRequestPreferredChannel @default(IN_APP)
  status            AdviceRequestStatus           @default(ACTIVE)
  completedAt       DateTime?
  canceledAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process             AdviceProcess            @relation(fields: [processId], references: [id], onDelete: Cascade)
  requestedBy         User                     @relation("AdviceRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  targetCircle        Circle?                  @relation("AdviceRequestTargetCircle", fields: [targetCircleId], references: [id], onDelete: SetNull)
  recipients          AdviceRequestRecipient[]
  deliberationEntries DeliberationEntry[]

  @@index([workspaceId, processId])
  @@index([workspaceId, status, deadlineAt])
  @@index([workspaceId, status, reminderAt])
  @@index([targetCircleId])
}

model AdviceRequestRecipient {
  id        String   @id @default(uuid())
  requestId String
  memberId  String
  createdAt DateTime @default(now())

  request AdviceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  member  Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([requestId, memberId])
  @@index([memberId])
}

// --- Impact Footprint ---

model ImpactFootprint {
  id                   String   @id @default(uuid())
  workspaceId          String
  memberId             String
  periodStart          DateTime
  periodEnd            DateTime
  proposalsAuthored    Int      @default(0)
  proposalsExecuted    Int      @default(0)
  adviceGiven          Int      @default(0)
  adviceSoughtCount    Int      @default(0)
  tensionsResolved     Int      @default(0)
  actionsCompleted     Int      @default(0)
  endorsementsReceived Int      @default(0)
  concernsRaised       Int      @default(0)
  meetingsParticipated Int      @default(0)
  detailJson           Json?
  createdAt            DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, memberId, periodStart, periodEnd])
  @@index([workspaceId, memberId])
}

model DemoLead {
  id                    String                 @id @default(uuid())
  workspaceId           String
  email                 String
  source                String                 @default("demo_gate")
  createdAt             DateTime               @default(now())
  lastSeenAt            DateTime               @default(now())
  visitCount            Int                    @default(1)
  qualifyToken          String?                @unique
  companyHint           String?
  ipCountry             String?
  referrerUrl           String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  welcomeEmailSentAt    DateTime?
  convertedAt           DateTime?
  convertedContactId    String?
  followUpCount         Int                    @default(0)
  lastFollowUpAt        DateTime?
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  crmQualifications     CrmQualification[]
  crmConversations      CrmConversation[]
  crmProspectWorkspaces CrmProspectWorkspace[]
  newspaperDeliveries   NewspaperDelivery[]

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

// --- CRM ---

enum CrmDealStage {
  LEAD // Just captured, no qualification
  QUALIFIED // Confirmed fit
  PROPOSAL // Proposal sent
  NEGOTIATION // In negotiation
  CLOSED_WON // Deal won
  CLOSED_LOST // Deal lost
}

enum CrmActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK
}

model CrmAccount {
  id               String    @id @default(uuid())
  workspaceId      String
  name             String
  slug             String
  domain           String?
  relationshipType String    @default("PROSPECT")
  lifecycleStage   String    @default("DISCOVERY")
  descriptionMd    String?   @db.Text
  source           String    @default("manual")
  tags             String[]  @default([])
  ownerUserId      String?
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts                 CrmContact[]
  deals                    CrmDeal[]
  activities               CrmActivity[]
  communicationSuggestions CrmCommunicationSuggestion[]
  crmConversations         CrmConversation[]
  prospectWorkspaces       CrmProspectWorkspace[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, relationshipType, lifecycleStage])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, domain])
}

model CrmContact {
  id               String    @id @default(uuid())
  workspaceId      String
  accountId        String?
  email            String
  name             String?
  company          String?
  title            String?
  phone            String?
  source           String    @default("manual") // manual, demo_gate, import, api
  tags             String[]  @default([])
  avatarUrl        String?
  lastSeenAt       DateTime  @default(now())
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                  CrmAccount?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deals                    CrmDeal[]
  activities               CrmActivity[]
  communicationSuggestions CrmCommunicationSuggestion[]
  crmConversations         CrmConversation[]

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, archivedAt])
  @@index([accountId])
}

model CrmDeal {
  id               String       @id @default(uuid())
  workspaceId      String
  accountId        String?
  contactId        String
  title            String
  stage            CrmDealStage @default(LEAD)
  valueCents       Int? // Monetary values as cents per repo convention
  currency         String       @default("USD")
  closedAt         DateTime?
  ownerUserId      String? // Workspace member who owns this deal
  notes            String?      @db.Text
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                  CrmAccount?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact                  CrmContact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities               CrmActivity[]
  communicationSuggestions CrmCommunicationSuggestion[]
  crmConversations         CrmConversation[]
  stageTransitions         CrmDealStageTransition[]
  @@index([workspaceId, stage])
  @@index([accountId])
  @@index([contactId])
  @@index([workspaceId, archivedAt])
}

model CrmDealStageTransition {
  id          String        @id @default(uuid())
  workspaceId String
  dealId      String
  fromStage   CrmDealStage?
  toStage     CrmDealStage
  actorUserId String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal      CrmDeal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, toStage, createdAt])
  @@index([dealId, createdAt])
}

model CrmActivity {
  id                String          @id @default(uuid())
  workspaceId       String
  accountId         String?
  contactId         String?
  dealId            String?
  actorUserId       String?
  ownerUserId       String?
  completedByUserId String?
  type              CrmActivityType @default(NOTE)
  title             String
  bodyMd            String?         @db.Text
  source            String          @default("manual")
  sourceExternalId  String?
  sourceUrl         String?
  sourceOccurredAt  DateTime?
  dueAt             DateTime?
  completedAt       DateTime?
  archivedAt        DateTime?
  archivedByUserId  String?
  archiveReason     String?
  createdAt         DateTime        @default(now())

  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                  CrmAccount?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact                  CrmContact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal                     CrmDeal?                     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  communicationSuggestions CrmCommunicationSuggestion[]

  @@unique([workspaceId, source, sourceExternalId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, type, dueAt])
  @@index([workspaceId, completedAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, ownerUserId, dueAt])
  @@index([workspaceId, source, sourceOccurredAt])
  @@index([accountId])
  @@index([contactId])
  @@index([dealId])
}

model CrmCommunicationSuggestion {
  id                String    @id @default(uuid())
  workspaceId       String
  accountId         String?
  contactId         String?
  dealId            String?
  activityId        String?
  actorUserId       String?
  ownerUserId       String?
  status            String    @default("SUGGESTED")
  channel           String    @default("EMAIL")
  title             String
  subject           String?
  bodyMd            String    @db.Text
  recipientEmail    String?
  recipientName     String?
  source            String    @default("manual")
  requestedAt       DateTime?
  sentAt            DateTime?
  declinedAt        DateTime?
  failedAt          DateTime?
  failureReason     String?   @db.Text
  externalRequestId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   CrmAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact   CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      CrmDeal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  activity  CrmActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, ownerUserId, status])
  @@index([accountId, status])
  @@index([contactId, status])
  @@index([dealId, status])
  @@index([activityId])
}

model WorkspaceAgentConfig {
  id               String    @id @default(uuid())
  workspaceId      String
  agentKey         String
  enabled          Boolean   @default(true)
  modelOverride    String?
  governancePolicy String?   @db.Text
  configJson       Json      @default("{}")
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentKey])
  @@index([workspaceId, archivedAt])
}

model WorkspaceSsoConfig {
  id              String   @id @default(uuid())
  workspaceId     String
  provider        String // "GOOGLE" | "MICROSOFT"
  clientId        String
  clientSecretEnc String
  allowedDomains  String[]
  isEnabled       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model UserSsoIdentity {
  id                String   @id @default(uuid())
  userId            String
  provider          String // "GOOGLE" | "MICROSOFT"
  providerSubjectId String
  email             String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubjectId])
  @@index([userId])
}

model ModelUsageBudget {
  id                String    @id @default(uuid())
  workspaceId       String    @unique
  monthlyCostCapUsd Decimal   @db.Decimal(12, 2)
  alertThresholdPct Int       @default(80)
  periodStartDay    Int       @default(1)
  alertSentAt       DateTime?
