  createdAt         DateTime          @default(now())

  customerAccount CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  deployment      CustomerDeployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([customerAccountId, snapshotKind, createdAt], map: "FleetHealthSnapshot_customerAccountId_snapshotKind_createdAt_id")
  @@index([deploymentId, snapshotKind, createdAt])
  @@index([snapshotKind, createdAt])
  @@index([status, createdAt])
}

model CustomerEntitlement {
