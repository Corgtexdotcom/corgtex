  @@index([workspaceId])
  @@index([setupSessionId])
}

model ProviderCutover {
  id                        String                          @id @default(uuid())
  customerAccountId         String
  sourceDeploymentId        String
  destinationDeploymentId   String?
  sourceProvider            CustomerDeploymentCloudProvider
  destinationProvider       CustomerDeploymentCloudProvider
  status                    ProviderCutoverStatus           @default(PLANNED)
  sourceWriteStoppedAt      DateTime?
  destinationWriteStartedAt DateTime?
  finalSnapshotAt           DateTime?
  finalSnapshotChecksum     String?
  sourceDataFreshThroughAt  DateTime?
  observationCompletedAt    DateTime?
  archiveRestoreTestedAt    DateTime?
  archiveRetentionDeadline  DateTime?
  retentionWaiverApprovedAt DateTime?
  retentionWaiverApprovedBy String?
  retentionWaiverReason     String?
  sourceDeletedAt           DateTime?
  evidence                  Json?
  reason                    String
  recordedByUserId          String?
  transitionKey             String
  activeTransitionKey       String?                         @unique
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  account               CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceDeployment      CustomerDeployment  @relation("SourceDeployment", fields: [sourceDeploymentId, customerAccountId], references: [id, customerAccountId], onDelete: Restrict, onUpdate: Restrict)
  destinationDeployment CustomerDeployment? @relation("DestinationDeployment", fields: [destinationDeploymentId, customerAccountId], references: [id, customerAccountId], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerAccountId])
  @@index([sourceDeploymentId, customerAccountId])
  @@index([destinationDeploymentId, customerAccountId])
}
