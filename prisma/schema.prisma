enum ModuleGrantPrincipalType {
  MEMBER
  MEMBER_ROLE
  GOVERNANCE_ROLE
  CIRCLE
}

enum ModuleAccessLevel {
  NONE
  READ
  WRITE
}

// Per-workspace deviations from a module's default access policy. The module
// manifest provides defaults; rows here grant access to a specific member,
// member role, governance role, or circle. Resolution takes the highest level.
model WorkspaceModuleGrant {
  id              String                   @id @default(uuid())
  workspaceId     String
  moduleKey       String
  principalType   ModuleGrantPrincipalType
  principalId     String
  accessLevel     ModuleAccessLevel
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleKey, principalType, principalId])
  @@index([workspaceId, moduleKey])
}

enum ModuleAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// An individual's request for read/write access to a module. Admin approval
// creates a MEMBER grant for the requester (and flips the module's org opt-in
// flag on if it was off, without broadcasting the default policy to everyone).
model WorkspaceModuleAccessRequest {
  id              String                    @id @default(uuid())
  workspaceId     String
  moduleKey       String
  requestedAccess ModuleAccessLevel
  requesterUserId String
  reasonMd        String
  status          ModuleAccessRequestStatus @default(PENDING)
  decisionNoteMd  String?
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

