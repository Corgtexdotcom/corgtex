  deploymentStatus             CustomerDeploymentStatus        @default(DRAFT)
  cloudProvider                CustomerDeploymentCloudProvider @default(RAILWAY)
  remoteWorkspaceSlug          String?
  remoteWorkspaceId            String?
  region                       String?
  dataResidency                String?
  customDomain                 String?
  supportOwnerEmail            String?
  provisioningStatus           String                          @default("draft")
  bootstrapStatus              String                          @default("not_started")
  releaseVersion               String?
  releaseImageTag              String?
  releaseLeaseFence            Int                             @default(0)
  releaseLeaseId               String?                         @unique
  releaseLeaseTokenHash        String?                         @unique
  releaseLeaseOwner            String?
  releaseLeaseExpectedImageTag String?
  releaseLeaseIncomingImageTag String?
  releaseLeaseIncomingVersion  String?
  releaseLeasePhase            CustomerDeploymentReleaseLeasePhase?
  releaseLeaseAcquiredAt       DateTime?
  releaseLeaseHeartbeatAt      DateTime?
  releaseLeaseExpiresAt        DateTime?
  releaseLeaseRollbackRecord   Json?
  releaseLeaseRecoveryEvidence Json?
  releaseLeaseError            String?
  railwayProjectId             String?
  railwayEnvironmentId         String?
  railwayWebServiceId          String?
  railwayWorkerServiceId       String?
  railwayPostgresServiceId     String?
  railwayRedisServiceId        String?
  providerSubscriptionId       String?
  providerResourceGroup        String?
  providerProjectId            String?
  providerEnvironmentId        String?
  providerWebServiceId         String?
  providerWorkerServiceId      String?
  providerPostgresServiceId    String?
  providerRedisServiceId       String?
  providerStorageResourceId    String?
  providerLogsUrl              String?
  providerCostUrl              String?
  providerMetadata             Json?
  storageBucketName            String?
  bootstrapBundleUri           String?
  bootstrapBundleChecksum      String?
  bootstrapBundleSchemaVersion String?
  lastProvisioningError        String?
  lastHealthCheck              DateTime?
  lastHealthStatus             String?
  lastHealthError              String?
  lastWorkerHealthCheck        DateTime?
  lastWorkerHealthStatus       String?
  lastReleaseCheck             DateTime?
  supportBaseUrl               String?
  supportMcpUrl                String?
  supportCredentialEnc         String?
  supportCredentialLabel       String?
  supportConnectorStatus       String                          @default("not_configured")
  supportAccessMode            String                          @default("broad")
  supportLastConnectedAt       DateTime?
  supportLastSyncAt            DateTime?
  supportLastSyncError         String?
  supportNotes                 String?
  managedWorkspaceId           String?                         @unique
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  events                        CustomerDeploymentEvent[]
  accessGrants                  CustomerDeploymentAccess[]
  supportOperations             SupportOperation[]
  recorderSmokeRuns             MeetingRecorderSmokeRun[]
  managedWorkspace              Workspace?                 @relation(fields: [managedWorkspaceId], references: [id], onDelete: SetNull)
  customerAccount               CustomerAccount?           @relation("CustomerAccountDeployments", fields: [customerAccountId], references: [id], onDelete: SetNull)
  primaryForAccount             CustomerAccount?           @relation("CustomerAccountPrimaryDeployment")
  fleetSnapshots                FleetHealthSnapshot[]
  entitlements                  CustomerEntitlement[]
  releaseTargets                CustomerReleaseTarget[]
  appRuntimes                   AppRuntime[]
  clientMigrationsAsSource      ClientMigrationRun[]       @relation("ClientMigrationSourceDeployment")
  clientMigrationsAsDestination ClientMigrationRun[]       @relation("ClientMigrationDestinationDeployment")
  sourceProviderCutovers        ProviderCutover[]          @relation("SourceDeployment")
  destinationProviderCutovers   ProviderCutover[]          @relation("DestinationDeployment")

  @@unique([id, customerAccountId])
  @@index([customerAccountId])
  @@index([customerSlug])
  @@index([deploymentKind])
  @@index([deploymentStatus])
  @@index([cloudProvider])
  @@index([cloudProvider, deploymentStatus])
  @@index([releaseLeasePhase, releaseLeaseExpiresAt])
  @@index([provisioningStatus])
  @@index([bootstrapStatus])
  @@index([region])
  @@index([lastHealthStatus])
  @@index([supportConnectorStatus])
}

model FleetHealthSnapshot {
  id                String            @id @default(uuid())
  customerAccountId String
