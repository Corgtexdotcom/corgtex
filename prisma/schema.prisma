  @@unique([workspaceId, source, sourceExternalId])
  @@index([workspaceId, status])
  @@index([workspaceId, source, sourceOccurredAt])
  @@index([accountId])
  @@index([demoLeadId])
  @@index([contactId])
}

model CrmConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderType     String // LEAD, ADMIN, SYSTEM
  senderUserId   String? // if ADMIN
  senderEmail    String? // if LEAD or ADMIN (fallback)
  bodyMd         String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?           @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model CrmProspectWorkspace {
  id                String   @id @default(uuid())
  crmWorkspaceId    String
  accountId         String?
  demoLeadId        String
  targetWorkspaceId String
  adminEmail        String
  status            String   @default("PROVISIONING") // PROVISIONING, ACTIVE, SUSPENDED
  provisionedAt     DateTime @default(now())
  updatedAt         DateTime @updatedAt

  crmWorkspace    Workspace   @relation("CrmWorkspace", fields: [crmWorkspaceId], references: [id], onDelete: Cascade)
  targetWorkspace Workspace   @relation("TargetWorkspace", fields: [targetWorkspaceId], references: [id], onDelete: Cascade)
  account         CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  demoLead        DemoLead    @relation(fields: [demoLeadId], references: [id], onDelete: Cascade)

  @@index([crmWorkspaceId, status])
  @@index([accountId])
  @@index([demoLeadId])
  @@index([targetWorkspaceId])
}

/// Durable append-only evidence for protected tenant purge workflows.
/// Target and actor identifiers intentionally have no relations so history survives deletion.
model TenantPurgeRun {
  id                           String               @id @default(uuid())
  mode                         TenantPurgeRunMode
  status                       TenantPurgeRunStatus @default(PLANNED)
  targetAccountId              String?
  targetDeploymentId           String
  targetWorkspaceId            String
  targetTrialId                String?
  canonicalTargetKey           String
  activeTargetKey              String?              @unique(map: "TenantPurgeRun_activeTargetKey_key")
  capabilitySha                String
  manifestDigest               String?
  backupDigest                 String?
  restoreDigest                String?
  manifestEvidenceRef          String?
  backupEvidenceRef            String?
  restoreEvidenceRef           String?
  executionEvidenceRef         String?
  terminalEvidenceRef          String?
  requestedByUserId            String
  approvedByUserId             String?
  reason                       String
  requestedAt                  DateTime             @default(now())
  manifestCapturedAt           DateTime?
  backupCompletedAt            DateTime?
  restoreVerifiedAt            DateTime?
  approvedAt                   DateTime?
  approvalExpiresAt            DateTime?
  executionStartedAt           DateTime?
  terminalAt                   DateTime?
  failureCode                  String?
  resultDatabaseRowsDeleted    Int?
  resultBlobObjectsDeleted     Int?
  resultSearchDocumentsDeleted Int?
  resultCacheKeysCleared       Int?
  resultTargetRecordsRemaining Int?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @default(now()) @updatedAt

  @@index([canonicalTargetKey, createdAt], map: "TenantPurgeRun_canonicalTargetKey_createdAt_idx")
  @@index([status, createdAt], map: "TenantPurgeRun_status_createdAt_idx")
  @@index([requestedByUserId, createdAt], map: "TenantPurgeRun_requestedByUserId_createdAt_idx")
}

model CustomerAccount {
  id                  String                      @id @default(uuid())
  slug                String                      @unique
  displayName         String
  status              CustomerAccountStatus       @default(PROSPECT)
  managementAuthority CustomerManagementAuthority @default(CORGTEX)
  supportOwnerEmail   String?
  notes               String?
  primaryDeploymentId String?                     @unique
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  deployments       CustomerDeployment[]    @relation("CustomerAccountDeployments")
  primaryDeployment CustomerDeployment?     @relation("CustomerAccountPrimaryDeployment", fields: [primaryDeploymentId], references: [id], onDelete: SetNull)
  fleetSnapshots    FleetHealthSnapshot[]
  entitlements      CustomerEntitlement[]
  releaseTargets    CustomerReleaseTarget[]
  clientMigrations  ClientMigrationRun[]
  providerCutovers  ProviderCutover[]

  @@index([status])
  @@index([managementAuthority])
  @@index([supportOwnerEmail])
}

model CustomerDeployment {
  id                           String                          @id @default(uuid())
  label                        String
  url                          String                          @unique
  environment                  String                          @default("production")
  notes                        String?
  customerSlug                 String?
  customerAccountId            String?
