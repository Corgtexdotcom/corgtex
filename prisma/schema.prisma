model WorkspaceFeatureFlag {
  id          String   @id @default(uuid())
  workspaceId String
  flag        String
  enabled     Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, flag])
}

model FinanceClient {
  id              String              @id @default(uuid())
  workspaceId     String
  name            String
  status          FinanceRecordStatus @default(ACTIVE)
  notesMd         String?             @db.Text
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  FinanceProject[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
}

model FinanceConsultant {
  id               String              @id @default(uuid())
  workspaceId      String
  name             String
  memberId         String?
  status           FinanceRecordStatus @default(ACTIVE)
  defaultRateCents Int?
  createdByUserId  String?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member        Member?                    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  timeEntries   FinanceTimeEntry[]
  expenses      FinanceExpense[]
  contributions FinanceContributionEntry[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, memberId])
  @@index([workspaceId, updatedAt])
}

model FinanceProject {
  id              String               @id @default(uuid())
  workspaceId     String
  clientId        String?
  name            String
  status          FinanceProjectStatus @default(ACTIVE)
  budgetCents     Int?
  currency        String               @default("USD") @db.VarChar(3)
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        FinanceClient?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries   FinanceTimeEntry[]
  expenses      FinanceExpense[]
  contributions FinanceContributionEntry[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, updatedAt])
}

model FinanceTimeEntry {
  id               String             @id @default(uuid())
  workspaceId      String
  projectId        String?
  consultantId     String?
  occurredOn       DateTime
  minutes          Int
  rateCents        Int?
  status           FinanceEntryStatus @default(SUBMITTED)
  notesMd          String?            @db.Text
  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    FinanceProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  consultant FinanceConsultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredOn])
  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
  @@index([workspaceId, consultantId])
  @@index([workspaceId, updatedAt])
}

model FinanceExpense {
  id               String             @id @default(uuid())
  workspaceId      String
  projectId        String?
  consultantId     String?
  occurredOn       DateTime
  amountCents      Int
  currency         String             @default("USD") @db.VarChar(3)
  status           FinanceEntryStatus @default(SUBMITTED)
  notesMd          String?            @db.Text
  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    FinanceProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  consultant FinanceConsultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredOn])
  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
  @@index([workspaceId, consultantId])
  @@index([workspaceId, updatedAt])
}

model FinanceContributionEntry {
  id                String                           @id @default(uuid())
  workspaceId       String
  projectId         String?
  consultantId      String?
  contributorUserId String?
  submittedByUserId String?
  type              FinanceContributionType
  paymentChoice     FinanceContributionPaymentChoice
  cashStatus        FinanceContributionCashStatus    @default(NOT_APPLICABLE)
  occurredAt        DateTime
  minutes           Int?
  amountCents       Int?
  currency          String                           @default("USD") @db.VarChar(3)
  descriptionMd     String?                          @db.Text
  paidByUserId      String?
  paidAt            DateTime?
  version           Int                              @default(1)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    FinanceProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  consultant FinanceConsultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, contributorUserId])
  @@index([workspaceId, submittedByUserId])
  @@index([workspaceId, paymentChoice])
  @@index([workspaceId, cashStatus])
  @@index([workspaceId, updatedAt])
}

model FinanceReport {
  id            String                 @id @default(uuid())
  workspaceId   String
  reportType    FinanceReportType
  basis         FinanceAccountingBasis
  cadence       FinanceReportCadence
  currency      String                 @db.VarChar(3)
  periodStart   DateTime               @db.Date
  periodEnd     DateTime               @db.Date
  asOfDate      DateTime?              @db.Date
  title         String                 @db.VarChar(200)
  status        FinanceReportStatus    @default(ACTIVE)
  sourceBatchId String                 @unique
  version       Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceBatch FinanceImportBatch  @relation(fields: [sourceBatchId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  facts       FinanceReportFact[]

  @@index([workspaceId, status])
  @@index([workspaceId, periodEnd])
  @@unique([id, workspaceId])
  @@unique([sourceBatchId, workspaceId])
}

model FinanceReportFact {
  id                String                @id @default(uuid())
  workspaceId       String
  reportId          String
  accountPath       String[]
  kind              FinanceReportFactKind
  periodStart       DateTime              @db.Date
