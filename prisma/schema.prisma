model CustomerDeploymentEvent {
  id           String   @id @default(uuid())
  deploymentId String?
  actorUserId  String?
  action       String
  meta         Json?
  createdAt    DateTime @default(now())

  deployment CustomerDeployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([deploymentId, createdAt])
  @@index([action, createdAt])
}

model ClientMigrationRun {
  id                      String    @id @default(uuid())
  customerAccountId       String
  sourceDeploymentId      String
  destinationDeploymentId String?
  direction               String
  status                  String    @default("planned")
  actorUserId             String?
  actorLabel              String?
  reason                  String
  planSummary             Json?
  verificationSummary     Json?
  error                   String?
  dryRunAt                DateTime?
  executedAt              DateTime?
  finalizedAt             DateTime?
  rolledBackAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customerAccount       CustomerAccount        @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  sourceDeployment      CustomerDeployment     @relation("ClientMigrationSourceDeployment", fields: [sourceDeploymentId], references: [id], onDelete: Cascade)
  destinationDeployment CustomerDeployment?    @relation("ClientMigrationDestinationDeployment", fields: [destinationDeploymentId], references: [id], onDelete: SetNull)
  idMaps                ClientMigrationIdMap[]

  @@index([customerAccountId, status, createdAt])
  @@index([sourceDeploymentId, createdAt])
  @@index([destinationDeploymentId, createdAt])
}

model ClientMigrationIdMap {
  id             String   @id @default(uuid())
  migrationRunId String
  entityType     String
  sourceId       String
  destinationId  String?
  checksum       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  migrationRun ClientMigrationRun @relation(fields: [migrationRunId], references: [id], onDelete: Cascade)

  @@unique([migrationRunId, entityType, sourceId])
  @@index([destinationId])
}

model CustomerDeploymentAccess {
  id           String                       @id @default(uuid())
  deploymentId String
  userId       String
  role         CustomerDeploymentAccessRole @default(SUPPORT_VIEWER)
  isActive     Boolean                      @default(true)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  deployment CustomerDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, userId])
  @@index([userId, isActive])
  @@index([deploymentId, isActive])
}

model SupportOperation {
  id             String                 @id @default(uuid())
  deploymentId   String?
  workspaceId    String?
  actorUserId    String?
  actorLabel     String                 @default("Corgtex Support")
  action         String
  reason         String
  status         SupportOperationStatus @default(PENDING)
  inputSummary   Json?
  resultSummary  Json?
  error          String?
  idempotencyKey String?                @unique
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  deployment CustomerDeployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  actor      User?               @relation("SupportOperationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([deploymentId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@index([action, createdAt])
}

