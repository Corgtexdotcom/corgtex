# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/package.json
COPY apps/site/package.json apps/site/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/workflows/package.json packages/workflows/package.json
COPY packages/agents/package.json packages/agents/package.json
COPY packages/models/package.json packages/models/package.json
COPY packages/knowledge/package.json packages/knowledge/package.json
COPY packages/mcp/package.json packages/mcp/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/connectors-sql/package.json packages/connectors-sql/package.json
COPY prisma ./prisma
RUN npm ci --ignore-scripts
RUN npx prisma generate

FROM deps AS build
ARG CORGTEX_RELEASE_GIT_SHA
ARG RAILWAY_GIT_COMMIT_SHA
ARG GITHUB_SHA
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
ARG REQUIRE_NEXT_SERVER_ACTIONS_KEY=false
COPY . .
RUN --mount=type=secret,id=next_server_actions_encryption_key \
  set -eu; \
  key="${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY:-}"; \
  if [ -f /run/secrets/next_server_actions_encryption_key ]; then key="$(cat /run/secrets/next_server_actions_encryption_key)"; fi; \
  export NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="$key"; \
  export CORGTEX_RELEASE_GIT_SHA RAILWAY_GIT_COMMIT_SHA GITHUB_SHA; \
  if [ "$REQUIRE_NEXT_SERVER_ACTIONS_KEY" = "true" ]; then \
    node scripts/verify-next-server-actions-key.mjs --required; \
  else \
    node scripts/verify-next-server-actions-key.mjs; \
  fi; \
  NODE_OPTIONS=--max-old-space-size=4096 npm run build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/apps/web ./apps/web
COPY --from=build /app/apps/site/package.json ./apps/site/package.json
COPY --from=build /app/packages ./packages
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/deploy ./deploy
EXPOSE 3000
CMD ["sh", "/app/deploy/entrypoint.sh"]
